# Copy to .env and fill in: cp .env.example .env

# Your user and group IDs (run `id` to see them)
PUID=1000
PGID=1000

# GPU access group: getent group render | cut -d: -f3
RENDER_GID=992

TZ=America/New_York

# Folder holding your movies/shows/music, e.g. /mnt/media
MEDIA_DIR=/mnt/media

# Only for the "own domain" option; leave blank otherwise
DOMAIN=
PUBLIC_URL=
